  },
  "dependencies": {
    "@next/third-parties": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch@3.1.5": "10.2.6",
    "minimatch@10.2.5": "10.2.6",
    "brace-expansion": "5.0.8",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
